.page-container {
  height: 100vh;
  background: #fef5f0;
  display: flex;
  flex-direction: column;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15rpx;
  transition: all 0.3s;
}

.checkbox.checked {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-color: #ff6b6b;
}

.checkbox text {
  font-size: 24rpx;
  color: #ffffff;
}

.select-text {
  font-size: 28rpx;
  color: #333333;
}

.edit-btn {
  font-size: 28rpx;
  color: #ff6b6b;
}

.cart-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx;
}

.cart-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
  position: relative;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-checkbox {
  margin-right: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.item-spec {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 20rpx;
  color: #ff6b6b;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.quantity-control {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 4rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
}

.qty-btn.minus:active,
.qty-btn.plus:active {
  background: #e0e0e0;
  border-radius: 50%;
}

.qty-value {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333333;
}

.delete-btn {
  position: absolute;
  right: 20rpx;
  width: 80rpx;
  height: 60rpx;
  background: #ff4d4f;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn text {
  font-size: 24rpx;
  color: #ffffff;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-top: 2rpx solid #f0f0f0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-left {
  display: flex;
  align-items: baseline;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 8rpx;
}

.total-symbol {
  font-size: 24rpx;
  color: #ff6b6b;
}

.total-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.total-count {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
}

.checkout-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  min-width: 180rpx;
}

.checkout-btn[disabled] {
  background: #cccccc;
}

.go-shopping-btn:active,
.checkout-btn:active {
  opacity: 0.8;
}