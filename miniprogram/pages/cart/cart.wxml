<view class="page-container">
  <view class="cart-header">
    <view class="header-left">
      <view class="select-all" bindtap="toggleSelectAll">
        <view class="checkbox {{selectAll ? 'checked' : ''}}">
          <text wx:if="{{selectAll}}">✓</text>
        </view>
        <text class="select-text">全选</text>
      </view>
    </view>
    <view class="header-right">
      <text class="edit-btn" bindtap="toggleEdit">
        {{isEditMode ? '完成' : '编辑'}}
      </text>
    </view>
  </view>

  <scroll-view scroll-y class="cart-scroll">
    <view class="cart-list" wx:if="{{cart.length > 0}}">
      <view class="cart-item" wx:for="{{cart}}" wx:key="index">
        <view class="item-checkbox" bindtap="toggleItemSelect" data-index="{{index}}">
          <view class="checkbox {{selectedItems[index] ? 'checked' : ''}}">
            <text wx:if="{{selectedItems[index]}}">✓</text>
          </view>
        </view>
        <image class="item-image" src="{{item.image}}" mode="aspectFill" bindtap="goToDetail" data-id="{{item._id}}"/>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-spec">{{item.spec}} / {{item.sugar}} / {{item.temp}}</text>
          <view class="item-bottom">
            <view class="item-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
            </view>
            <view class="quantity-control">
              <view class="qty-btn minus" bindtap="decreaseQty" data-index="{{index}}">-</view>
              <text class="qty-value">{{item.quantity}}</text>
              <view class="qty-btn plus" bindtap="increaseQty" data-index="{{index}}">+</view>
            </view>
          </view>
        </view>
        <view class="delete-btn" wx:if="{{isEditMode}}" bindtap="deleteItem" data-index="{{index}}">
          <text>删除</text>
        </view>
      </view>
    </view>

    <view class="empty-cart" wx:else>
      <text class="empty-icon">🛒</text>
      <text class="empty-title">购物车空空如也</text>
      <text class="empty-desc">快去挑选心仪的饮品吧</text>
      <button class="go-shopping-btn" bindtap="goShopping">去逛逛</button>
    </view>
  </scroll-view>

  <view class="cart-footer" wx:if="{{cart.length > 0}}">
    <view class="footer-left">
      <view class="total-info">
        <text class="total-label">合计:</text>
        <text class="total-symbol">¥</text>
        <text class="total-value">{{totalPrice}}</text>
      </view>
      <text class="total-count">共 {{totalCount}} 件</text>
    </view>
    <button class="checkout-btn" bindtap="checkout" disabled="{{selectedCount === 0}}">
      {{isEditMode ? `删除(${selectedCount})` : `结算(${selectedCount})`}}
    </button>
  </view>
</view>