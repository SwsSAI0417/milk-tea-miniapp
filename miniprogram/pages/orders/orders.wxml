<view class="page-container">
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
      <view class="tab-indicator" wx:if="{{currentTab === item.key}}"></view>
    </view>
  </view>

  <scroll-view scroll-y class="orders-scroll">
    <view class="orders-list" wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderNo">
        <view class="order-header">
          <text class="order-no">订单号: {{item.orderNo}}</text>
          <text class="order-status" style="color:{{getStatusColor(item.status)}}">{{getStatusText(item.status)}}</text>
        </view>
        <view class="order-items">
          <view class="order-item" wx:for="{{item.items}}" wx:key="index">
            <image class="item-image" src="{{item.image}}" mode="aspectFill"/>
            <view class="item-info">
              <text class="item-name">{{item.name}}</text>
              <text class="item-spec">{{item.spec}} / {{item.sugar}} / {{item.temp}}</text>
              <view class="item-bottom">
                <text class="item-price">¥{{item.price}}</text>
                <text class="item-qty">x{{item.quantity}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="order-footer">
          <text class="order-total">合计: ¥{{item.totalPrice}}</text>
          <button class="order-btn" bindtap="handleOrderAction" data-order="{{item}}">
            {{getActionText(item.status)}}
          </button>
        </view>
      </view>
    </view>

    <view class="empty-orders" wx:else>
      <text class="empty-icon">📋</text>
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">快去下单吧</text>
      <button class="go-shopping-btn" bindtap="goShopping">去下单</button>
    </view>
  </scroll-view>
</view>