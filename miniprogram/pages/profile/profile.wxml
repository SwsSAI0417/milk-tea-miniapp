<view class="page-container">
  <view class="profile-header">
    <view class="user-info">
      <view class="avatar">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-detail">
        <text class="user-name">用户昵称</text>
        <text class="user-id">ID: 12345678</text>
      </view>
    </view>
    <view class="edit-btn" bindtap="editProfile">
      <text>编辑资料</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{orderStats.total}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{orderStats.pending}}</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{orderStats.paid}}</text>
      <text class="stat-label">待配送</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{orderStats.delivered}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header" bindtap="goToOrders">
      <text class="section-title">我的订单</text>
      <view class="more-arrow">
        <text>全部订单</text>
        <text class="arrow">→</text>
      </view>
    </view>
    <view class="order-icons">
      <view class="order-icon-item" bindtap="goToOrdersWithStatus" data-status="pending">
        <view class="icon-wrapper">
          <text>💳</text>
        </view>
        <text class="icon-label">待支付</text>
      </view>
      <view class="order-icon-item" bindtap="goToOrdersWithStatus" data-status="paid">
        <view class="icon-wrapper">
          <text>🚗</text>
        </view>
        <text class="icon-label">待配送</text>
      </view>
      <view class="order-icon-item" bindtap="goToOrdersWithStatus" data-status="delivered">
        <view class="icon-wrapper">
          <text>✅</text>
        </view>
        <text class="icon-label">已完成</text>
      </view>
      <view class="order-icon-item">
        <view class="icon-wrapper">
          <text>⭐</text>
        </view>
        <text class="icon-label">待评价</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToCoupons">
      <view class="menu-icon">🎫</view>
      <text class="menu-text">优惠券</text>
      <text class="menu-badge">3张可用</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goToAddress">
      <view class="menu-icon">📍</view>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goToFavorites">
      <view class="menu-icon">❤️</view>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goToHistory">
      <view class="menu-icon">📖</view>
      <text class="menu-text">浏览记录</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goToHelp">
      <view class="menu-icon">❓</view>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-icon">⚙️</view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <view class="service-section">
    <button class="service-btn" bindtap="contactService">
      <text class="service-icon">💬</text>
      <text>在线客服</text>
    </button>
  </view>
</view>