.page-container {
  display: flex;
  height: 100vh;
  background: #fef5f0;
}

.category-sidebar {
  width: 200rpx;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.sidebar-header {
  padding: 30rpx 20rpx;
  border-bottom: 2rpx solid #eeeeee;
}

.sidebar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.sidebar-scroll {
  flex: 1;
  height: 0;
}

.sidebar-item {
  padding: 30rpx 20rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.sidebar-item.active {
  background: #ffffff;
}

.item-name {
  font-size: 26rpx;
  color: #666666;
}

.sidebar-item.active .item-name {
  color: #ff6b6b;
  font-weight: 600;
}

.active-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #ff6b6b, #ff8e8e);
  border-radius: 0 6rpx 6rpx 0;
}

.category-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.content-header {
  padding: 20rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.content-count {
  font-size: 24rpx;
  color: #999999;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx;
}

.products-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: calc(50% - 15rpx);
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.product-info {
  padding: 16rpx;
  position: relative;
}

.product-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 20rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 20rpx;
  color: #ff6b6b;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.add-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 300;
}

.add-btn:active {
  opacity: 0.8;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}