<view class="page-container">
  <scroll-view scroll-y class="detail-scroll">
    <view class="product-images">
      <swiper class="image-swiper" indicator-dots="true" autoplay="false" circular="false">
        <swiper-item>
          <image class="product-image" src="{{product.image}}" mode="aspectFill"/>
        </swiper-item>
      </swiper>
    </view>

    <view class="product-info-card">
      <view class="product-header">
        <text class="product-name">{{product.name}}</text>
        <view class="product-tag" wx:if="{{product.tag}}">{{product.tag}}</view>
      </view>
      <text class="product-desc">{{product.description}}</text>
      <view class="product-stats">
        <text class="sales">已售 {{product.sales}} 杯</text>
        <text class="rating">★★★★★</text>
      </view>
      <view class="product-price-row">
        <view class="product-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{product.price}}</text>
        </view>
        <text class="original-price" wx:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
      </view>
    </view>

    <view class="specs-card">
      <view class="spec-item">
        <text class="spec-label">规格</text>
        <view class="spec-options">
          <view 
            class="spec-option {{selectedSpec === item ? 'active' : ''}}" 
            wx:for="{{product.specs}}" 
            wx:key="item"
            bindtap="selectSpec"
            data-spec="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="spec-item">
        <text class="spec-label">甜度</text>
        <view class="spec-options">
          <view 
            class="spec-option {{selectedSugar === item ? 'active' : ''}}" 
            wx:for="{{product.sugar}}" 
            wx:key="item"
            bindtap="selectSugar"
            data-sugar="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="spec-item">
        <text class="spec-label">温度</text>
        <view class="spec-options">
          <view 
            class="spec-option {{selectedTemp === item ? 'active' : ''}}" 
            wx:for="{{product.temp}}" 
            wx:key="item"
            bindtap="selectTemp"
            data-temp="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>
    </view>

    <view class="qty-card">
      <text class="qty-label">数量</text>
      <view class="qty-control">
        <view class="qty-btn minus" bindtap="decreaseQty" bindlongpress="decreaseQtyFast">-</view>
        <text class="qty-value">{{quantity}}</text>
        <view class="qty-btn plus" bindtap="increaseQty" bindlongpress="increaseQtyFast">+</view>
      </view>
    </view>

    <view class="info-card">
      <view class="info-item">
        <text class="info-icon">🌱</text>
        <text class="info-text">新鲜食材，当日现做</text>
      </view>
      <view class="info-item">
        <text class="info-icon">⏱️</text>
        <text class="info-text">下单后约15分钟可取</text>
      </view>
      <view class="info-item">
        <text class="info-icon">🏆</text>
        <text class="info-text">品质保证，不满意可退</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="action-bar">
    <view class="action-left">
      <view class="action-item" bindtap="goHome">
        <text class="action-icon">🏠</text>
        <text class="action-text">首页</text>
      </view>
      <view class="action-item" bindtap="goCart">
        <text class="action-icon">🛒</text>
        <text class="action-text">购物车</text>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
    </view>
    <view class="action-right">
      <button class="add-cart-btn" bindtap="addToCart">加入购物车</button>
      <button class="buy-now-btn" bindtap="buyNow">立即购买</button>
    </view>
  </view>
</view>