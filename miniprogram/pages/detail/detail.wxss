.page-container {
  height: 100vh;
  background: #fef5f0;
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  flex: 1;
  height: 0;
}

.product-images {
  background: #ffffff;
}

.image-swiper {
  width: 100%;
  height: 600rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.product-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.product-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.product-tag {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 20rpx;
}

.product-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sales {
  font-size: 24rpx;
  color: #999999;
}

.rating {
  font-size: 24rpx;
  color: #faad14;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff6b6b;
}

.price-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.original-price {
  font-size: 26rpx;
  color: #cccccc;
  text-decoration: line-through;
  margin-left: 20rpx;
}

.specs-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.spec-item {
  margin-bottom: 30rpx;
}

.spec-item:last-child {
  margin-bottom: 0;
}

.spec-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
}

.spec-option.active {
  background: linear-gradient(135deg, #ffe4e1, #ffcdd2);
  color: #ff6b6b;
}

.qty-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.qty-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.qty-control {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 6rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
}

.qty-btn.minus:active,
.qty-btn.plus:active {
  background: #e0e0e0;
  border-radius: 50%;
}

.qty-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333333;
}

.info-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666666;
}

.bottom-space {
  height: 180rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-left {
  display: flex;
  gap: 40rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 20rpx;
  color: #666666;
  margin-top: 4rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.action-right {
  display: flex;
  gap: 16rpx;
}

.add-cart-btn {
  background: linear-gradient(135deg, #ffe4e1, #ffcdd2);
  color: #ff6b6b;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  border: none;
}

.buy-now-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  border: none;
}

.add-cart-btn:active,
.buy-now-btn:active {
  opacity: 0.8;
}